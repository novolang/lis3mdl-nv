// lis3mdl — ST's LIS3MDL three-axis magnetometer, on its I2C or its SPI
// bus, as devices-nv's `Magnetometer` and `Identifiable`.
//
// The facts below are from ST's data sheet "LIS3MDL: Digital output
// magnetic sensor: ultra-low-power, high-performance 3-axis magnetometer",
// DocID024204 Rev 4, May 2015; the tables and sections named are that
// sheet's.  Where the sheet and the drivers read for this one disagree,
// the site says which was taken.
//
// The register map (§ 6, Table 16), as this driver uses it:
//
//   0x0F  WHO_AM_I    0x3D
//   0x20  CTRL_REG1   TEMP_EN (7), OM (6:5), DO (4:2), FAST_ODR (1), ST (0)
//   0x21  CTRL_REG2   FS (6:5), REBOOT (3), SOFT_RST (2)
//   0x22  CTRL_REG3   LP (5), SIM (2), MD (1:0)
//   0x23  CTRL_REG4   OMZ (3:2), BLE (1)
//   0x24  CTRL_REG5   FAST_READ (7), BDU (6)
//   0x27  STATUS_REG  ZYXOR (7), ZYXDA (3)
//   0x28  OUT_X_L to 0x2D OUT_Z_H: each axis a 16-bit two's complement
//         count, low byte first
//   0x30  INT_CFG     the threshold interrupt on the INT pin, not used
//
// Bits that Table 23, 26, 29 and 32 mark "must be 0" are written 0.
//
// The sensitivity (Table 3) is 6842, 3421, 2281 and 1711 counts per gauss
// at the four full scales, ±4, ±8, ±12 and ±16 gauss, and one gauss is
// 100 000 nT, so a count is `100000 / counts_per_gauss` nT.  The driver
// multiplies before it divides, so 6842 counts at ±4 gauss are exactly
// 100 000 nT.
//
// The output data rate.  DO (Table 22) selects 0.625, 1.25, 2.5, 5, 10,
// 20, 40 or 80 Hz.  With FAST_ODR set (Table 20) the rate follows the
// performance mode OM instead: 1000, 560, 300 or 155 Hz for the low-power,
// medium, high and ultra-high performance modes.  Fix kept: the X and Y
// axes take their performance mode from OM in CTRL_REG1 and the Z axis from
// OMZ in CTRL_REG4, and the two must agree; Zephyr's lis3mdl driver
// derives OMZ from OM, and the `lis3mdl-driver` crate writes both in one
// call.  This driver writes both together.
//
// The data-ready.  The part has a DRDY pin of its own, which needs no
// configuration (the INT pin is the threshold interrupt, left off): it
// goes high when a new set of data is ready and low when the output
// registers are read.  Fix kept: Zephyr's driver reads one sample before it
// arms the edge interrupt, because a DRDY left high from before gives no
// rising edge; `start` ends with such a read.
//
// The two buses (§ 5).  On I2C the part answers at 0x1C (SDO/SA1 low) or
// 0x1E (high), and bit 7 of the sub-address makes the register address
// advance after each byte.  On SPI a transaction is a command byte, then
// data, inside one chip-select window: bit 7 is RW (1 reads), bit 6 is MS
// (1 advances the register address after each byte), bits 5 to 0 the
// register.  The two put the increment in different places, and a driver
// that sets bit 7 on SPI sets RW.  The part drives SDO on the falling edge
// of SPC and samples SDI on the rising edge, with SPC idle high, which is
// SPI mode 3, up to 10 MHz (Table 6).  CS high keeps the part on I2C.
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/st/lis3mdl` and the `lis3mdl-driver` crate 0.1.0.  Each
// fix kept is named at its site.
//
// The driver holds no state: the range, the mode and the rate are read
// from the part in the same transaction as the sample.
//
// A bus enters through `Lis3mdlPort`, which a type that holds a bus
// implements: `Lis3mdl` for an I2C bus and `Lis3mdlSpi` for an SPI bus.
// The framing of each bus is the generic functions `i2c_read_into`,
// `i2c_write`, `spi_read_into` and `spi_write`, so a test runs them over
// a double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_mag.{ MagNanoT, Magnetometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let WHO_AM_I    = 0x0F
let CTRL_REG1   = 0x20
let CTRL_REG2   = 0x21
let CTRL_REG3   = 0x22
let CTRL_REG4   = 0x23
let CTRL_REG5   = 0x24
let STATUS_REG  = 0x27
let OUT_X_L     = 0x28

// WHO_AM_I's value.
let ID_LIS3MDL = 0x3D

// The SPI command byte's RW and MS bits, and the I2C sub-address's
// auto-increment bit.
let SPI_READ  = 0x80
let SPI_MULTI = 0x40
let I2C_MULTI = 0x80

// CTRL_REG1: the performance mode of X and Y, the rate bits, FAST_ODR and
// the self-test enable.
let CTRL1_OM_MASK = 0x60
let CTRL1_DO_MASK = 0x1C
let CTRL1_FAST_ODR = 0x02
let CTRL1_ST = 0x01
// CTRL_REG2: the full-scale bits.
let CTRL2_FS_MASK = 0x60
// CTRL_REG3: low-power mode and the operating mode.
let CTRL3_LP = 0x20
let CTRL3_MD_MASK = 0x03
// CTRL_REG4: the performance mode of Z.
let CTRL4_OMZ_MASK = 0x0C
// CTRL_REG5: block data update, so the two bytes of an axis come from one
// sample.
let CTRL5_BDU = 0x40
// STATUS_REG: a new sample of all three axes.
let STATUS_ZYXDA = 0x08

// One gauss, in nanotesla.
let NT_PER_GAUSS = 100000

// The rate `start` sets, 10 Hz (DO 100), and the full scale and the
// performance mode: ±4 gauss, ultra-high performance.
let DO_10_HZ = 4
let OM_ULTRA_HIGH = 3

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ = 400000
let SPI_HZ = 4000000
let SPI_MODE = 3

// The most polls of the data-ready flag a self-test makes for one sample:
// a sample takes 12.5 ms at 80 Hz, and a poll over I2C takes about 100 us.
let SELF_TEST_POLLS = 4000

// The self-test's limits in nanotesla (Table 3, ±12 gauss, absolute
// value): 1 to 3 gauss on X and Y, 0.1 to 1 gauss on Z.
let ST_XY_MIN = 100000
let ST_XY_MAX = 300000
let ST_Z_MIN = 10000
let ST_Z_MAX = 100000

// The full scale of the part (Table 25).
pub @value
enum Lis3mdlRange
    Lis3mdlRange4g
    Lis3mdlRange8g
    Lis3mdlRange12g
    Lis3mdlRange16g

// The performance mode (Table 21 and Table 31): how many internal
// averages a sample takes, which sets the noise, the current and, with
// FAST_ODR, the rate.
pub @value
enum Lis3mdlPerf
    Lis3mdlLowPower
    Lis3mdlMedium
    Lis3mdlHigh
    Lis3mdlUltraHigh

// The operating mode (Table 28): converting continuously, one conversion
// and then power-down, or power-down.
pub @value
enum Lis3mdlPower
    Lis3mdlContinuous
    Lis3mdlSingle
    Lis3mdlPowerDown

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `irq_level` answers the level of the DRDY pin.
pub trait Lis3mdlPort
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]

// ── The two buses ────────────────────────────────────────────────────

// The sub-address that goes out for a read of `n` registers from `reg`
// on I2C: bit 7 set for more than one.
fn i2c_sub_of(reg: Int, n: Int) -> Int
    if n > 1
        return reg | I2C_MULTI
    reg

// The command byte that goes out for a read of `n` registers from `reg`
// on SPI: RW set, and MS set for more than one.  Without MS every byte
// repeats the first register.
fn spi_cmd_of(reg: Int, n: Int) -> Int
    var cmd = SPI_READ | (reg & 0x3F)
    if n > 1
        cmd = cmd | SPI_MULTI
    cmd

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the sub-address and a repeated start: whether the part
// answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, i2c_sub_of(reg, n), n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction:
// whether it ran, which is whether the wiring has a chip select.  An
// absent part reads 0xFF, which the callers check for.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                            n: Int, var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push(spi_cmd_of(reg, n) as u8)
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n, var dst)

// Writes `v` to the register `reg` in one SPI transaction, RW and MS
// clear: whether it ran.  The part answers nothing to a write.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x3F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the DRDY pin an input, the bus at 400 kHz.
// Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// Makes an SPI bus ready: chip select driven high first, so the pin
// never drives low and the part stays on the bus it was reset on, then
// an output; the DRDY pin an input; the bus at 4 MHz in mode 3.  Answers
// whether the wiring has a chip select.
pub fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    let Some(cs) = w.cs else return false
    gpio.set(cs, 1)
    gpio.mode(cs, 1)
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(SPI_HZ, SPI_MODE)
    true

// The level of the part's DRDY line on the board, 1 or 0, or -1 for a
// wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Lis3mdlPort>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.
pub fn reg_write<P: Lis3mdlPort>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `bits`, leaving the
// others: whether the part took it.  Every setting changes its own bits
// of the register read from the part, so the bits that must stay 0 and
// the settings of the other fields are not lost.
pub fn reg_update<P: Lis3mdlPort>(p: P, reg: Int, mask: Int, bits: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (bits & mask))

// ── Identity ─────────────────────────────────────────────────────────

// WHO_AM_I as a `DeviceId`, or `None` when no part answers: the byte
// reads 0xFF on an SPI bus no part drives and 0x00 on one held low.
pub fn id_read<P: Lis3mdlPort>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, WHO_AM_I) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: None })

// ── Conversions ──────────────────────────────────────────────────────

// The range a CTRL_REG2 byte's FS bits select.
pub fn range_of_ctrl2(v: Int) -> Lis3mdlRange
    match (v >> 5) & 3
        0 => Lis3mdlRange4g
        1 => Lis3mdlRange8g
        2 => Lis3mdlRange12g
        _ => Lis3mdlRange16g

// The FS bits, in place, for a range.
pub fn fs_of_range(r: Lis3mdlRange) -> Int
    match r
        Lis3mdlRange4g  => 0x00
        Lis3mdlRange8g  => 0x20
        Lis3mdlRange12g => 0x40
        Lis3mdlRange16g => 0x60

// The sensitivity of a range in counts per gauss (Table 3).
pub fn counts_per_gauss(r: Lis3mdlRange) -> Int
    match r
        Lis3mdlRange4g  => 6842
        Lis3mdlRange8g  => 3421
        Lis3mdlRange12g => 2281
        Lis3mdlRange16g => 1711

// The nanotesla of a signed count at a range: the count times 100 000
// nT a gauss over the counts per gauss, rounded toward zero.
pub fn nano_t_of(count: Int, r: Lis3mdlRange) -> Int
    count * NT_PER_GAUSS / counts_per_gauss(r)

// The performance mode a CTRL_REG1 byte's OM bits select.
pub fn perf_of_ctrl1(v: Int) -> Lis3mdlPerf
    match (v >> 5) & 3
        0 => Lis3mdlLowPower
        1 => Lis3mdlMedium
        2 => Lis3mdlHigh
        _ => Lis3mdlUltraHigh

// The OM bits, as a number 0 to 3, for a performance mode.  OM goes in
// bits 6:5 of CTRL_REG1 and OMZ in bits 3:2 of CTRL_REG4.
pub fn om_of_perf(m: Lis3mdlPerf) -> Int
    match m
        Lis3mdlLowPower => 0
        Lis3mdlMedium   => 1
        Lis3mdlHigh     => 2
        Lis3mdlUltraHigh => 3

// The operating mode a CTRL_REG3 byte's MD bits select: 00 continuous,
// 01 single conversion, 10 and 11 power-down (Table 28).
pub fn power_of_ctrl3(v: Int) -> Lis3mdlPower
    match v & 3
        0 => Lis3mdlContinuous
        1 => Lis3mdlSingle
        _ => Lis3mdlPowerDown

// The MD bits for an operating mode.
pub fn md_of_power(m: Lis3mdlPower) -> Int
    match m
        Lis3mdlContinuous => 0
        Lis3mdlSingle     => 1
        Lis3mdlPowerDown  => 2

// The rate in millihertz that the CTRL_REG1 and CTRL_REG3 bytes select:
// 0 unless the part converts continuously.  LP forces 0.625 Hz, and with
// FAST_ODR the performance mode sets the rate (Table 20).
pub fn rate_mhz_of(ctrl1: Int, ctrl3: Int) -> Int
    if (ctrl3 & CTRL3_MD_MASK) != 0
        return 0
    if (ctrl1 & CTRL1_FAST_ODR) != 0
        return fast_rate_mhz((ctrl1 >> 5) & 3)
    if (ctrl3 & CTRL3_LP) != 0
        return 625
    match (ctrl1 >> 2) & 7
        0 => 625
        1 => 1250
        2 => 2500
        3 => 5000
        4 => 10000
        5 => 20000
        6 => 40000
        _ => 80000

// The rate in whole hertz of a rate in millihertz, rounded up, so that
// 0.625 Hz is 1 and only a part that is not converting is 0.
pub fn rate_hz_of(mhz: Int) -> Int
    (mhz + 999) / 1000

// The FAST_ODR rate of the performance mode `om`, in millihertz.
fn fast_rate_mhz(om: Int) -> Int
    match om
        0 => 1000000
        1 => 560000
        2 => 300000
        _ => 155000

// The DO code of the slowest rate at or above `mhz`, up to 80 Hz.
pub fn do_for_rate(mhz: Int) -> Int
    if mhz <= 625
        return 0
    if mhz <= 1250
        return 1
    if mhz <= 2500
        return 2
    if mhz <= 5000
        return 3
    if mhz <= 10000
        return 4
    if mhz <= 20000
        return 5
    if mhz <= 40000
        return 6
    7

// The OM bits of the slowest FAST_ODR rate at or above `mhz`, between
// 80 Hz and the fastest, 1000 Hz: 155, 300, 560 or 1000 Hz.
pub fn om_for_fast_rate(mhz: Int) -> Int
    if mhz <= 155000
        return 3
    if mhz <= 300000
        return 2
    if mhz <= 560000
        return 1
    0

// The signed count of an axis whose low byte is at `i` of `b`.
fn axis(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i + 1] as Int << 8) | b[i] as Int, 16)

// ── Samples ──────────────────────────────────────────────────────────

// The most recent sample, in one transaction of thirteen registers from
// CTRL_REG2 to OUT_Z_H, so the range it is converted with is the one it
// was taken in: CTRL_REG2 to CTRL_REG5, the two reserved registers,
// STATUS_REG, then the three axes.  Reading the reserved registers
// changes nothing.  `None` when the part did not answer.
pub fn sample_read<P: Lis3mdlPort>(p: P) -> ?MagNanoT [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CTRL_REG2, 13, var b)
        return None
    let r = range_of_ctrl2(b[0] as Int)
    Some(MagNanoT { x: nano_t_of(axis(b, 7), r), y: nano_t_of(axis(b, 9), r), z: nano_t_of(axis(b, 11), r) })

// Whether a new sample of all three axes has completed since the last
// read: STATUS_REG's ZYXDA.
pub fn sample_ready<P: Lis3mdlPort>(p: P) -> Bool [hw]
    ((reg_read(p, STATUS_REG) ?? 0) & STATUS_ZYXDA) != 0

// The range the part is set to, ±4 gauss when it does not answer.
pub fn range_read<P: Lis3mdlPort>(p: P) -> Lis3mdlRange [hw]
    range_of_ctrl2(reg_read(p, CTRL_REG2) ?? 0)

// Sets the range and leaves the other bits of CTRL_REG2: whether the part
// took it.
pub fn range_write<P: Lis3mdlPort>(p: P, r: Lis3mdlRange) -> Bool [hw]
    reg_update(p, CTRL_REG2, CTRL2_FS_MASK, fs_of_range(r))

// The performance mode the part is in, ultra-high when it does not
// answer.
pub fn perf_read<P: Lis3mdlPort>(p: P) -> Lis3mdlPerf [hw]
    perf_of_ctrl1(reg_read(p, CTRL_REG1) ?? 0x60)

// Sets the performance mode of the X and Y axes and of the Z axis
// together: whether the part took both.  With FAST_ODR set the rate
// changes with the mode.
//
// Fix kept: OM and OMZ have to agree; Zephyr's driver writes OMZ from OM
// and the `lis3mdl-driver` crate writes the pair in one call.
pub fn perf_write<P: Lis3mdlPort>(p: P, m: Lis3mdlPerf) -> Bool [hw]
    let om = om_of_perf(m)
    reg_update(p, CTRL_REG1, CTRL1_OM_MASK, om << 5) and reg_update(p, CTRL_REG4, CTRL4_OMZ_MASK, om << 2)

// The operating mode the part is in, power-down when it does not answer.
pub fn power_read<P: Lis3mdlPort>(p: P) -> Lis3mdlPower [hw]
    power_of_ctrl3(reg_read(p, CTRL_REG3) ?? 2)

// Sets the operating mode and leaves the other bits of CTRL_REG3: whether
// the part took it.  Single conversion starts one conversion, after which
// the part is in power-down; it is for rates from 0.625 to 80 Hz.
pub fn power_write<P: Lis3mdlPort>(p: P, m: Lis3mdlPower) -> Bool [hw]
    reg_update(p, CTRL_REG3, CTRL3_MD_MASK, md_of_power(m))

// The rate in millihertz, 0 when the part is powered down, converting a
// single time, or does not answer.
pub fn rate_read<P: Lis3mdlPort>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CTRL_REG1, 3, var b)
        return 0
    rate_mhz_of(b[0] as Int, b[2] as Int)

// Sets the slowest rate at or above `mhz` millihertz and answers the rate
// the part took in millihertz, or 0 when it did not take it.  Up to 80 Hz
// the rate is DO, with FAST_ODR and LP clear and the performance mode
// kept.  Above 80 Hz the rate is set by the performance mode: 155, 300,
// 560 or 1000 Hz for ultra-high, high, medium and low-power, and the mode
// is set with it.  A request beyond 1000 Hz is 1000 Hz.
pub fn rate_write<P: Lis3mdlPort>(p: P, mhz: Int) -> Int [hw]
    var ok = false
    if mhz <= 80000
        ok = reg_update(p, CTRL_REG3, CTRL3_LP, 0) and reg_update(p, CTRL_REG1, CTRL1_DO_MASK | CTRL1_FAST_ODR, do_for_rate(mhz) << 2)
    else
        let om = om_for_fast_rate(mhz)
        ok = reg_update(p, CTRL_REG3, CTRL3_LP, 0) and reg_update(p, CTRL_REG4, CTRL4_OMZ_MASK, om << 2) and reg_update(p, CTRL_REG1, CTRL1_OM_MASK | CTRL1_FAST_ODR, (om << 5) | CTRL1_FAST_ODR)
    if not ok
        return 0
    rate_read(p)

// ── Self-test ────────────────────────────────────────────────────────

// Waits for the next sample by polling STATUS_REG's ZYXDA, at most
// `SELF_TEST_POLLS` times: whether one came.
fn wait_sample<P: Lis3mdlPort>(p: P) -> Bool [hw]
    for _i in 0..SELF_TEST_POLLS
        if sample_ready(p)
            return true
    false

// Two samples, the first discarded because the output settles over the
// first period, and the second answered.
fn settled_sample<P: Lis3mdlPort>(p: P) -> ?MagNanoT [hw]
    if not wait_sample(p)
        return None
    let _first = sample_read(p)
    if not wait_sample(p)
        return None
    sample_read(p)

// The change the part's self-test makes to its outputs (§ 7.2, ST in
// CTRL_REG1): the part at ±12 gauss in ultra-high performance at 80 Hz,
// converting continuously, is read with ST clear and again with ST set,
// and the answer is the second reading minus the first, in nanotesla.
// The settings the part had are put back.  `None` when the part did not
// answer or a sample did not come.  `self_test_ok` checks the change
// against Table 3's limits.
pub fn self_test_delta<P: Lis3mdlPort>(p: P) -> ?MagNanoT [hw]
    var saved: DevBytes = Vec.new()
    if not p.read_regs(CTRL_REG1, 5, var saved)
        return None
    let c1 = saved[0] as Int
    let on1 = CTRL1_OM_MASK | CTRL1_DO_MASK
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_write(p, CTRL_REG3, 0x03) and reg_write(p, CTRL_REG2, fs_of_range(Lis3mdlRange12g)) and reg_write(p, CTRL_REG4, 0x0C) and reg_write(p, CTRL_REG5, CTRL5_BDU) and reg_write(p, CTRL_REG1, on1) and reg_write(p, CTRL_REG3, 0x00)
        if let Some(off) = settled_sample(p)
            if reg_write(p, CTRL_REG1, on1 | CTRL1_ST)
                if let Some(on) = settled_sample(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    // The registers back in the order that keeps the part out of
    // conversion until the last: power-down, the rest, then the mode.
    let _pd = reg_write(p, CTRL_REG3, 0x03)
    let _r2 = reg_write(p, CTRL_REG2, saved[1] as Int)
    let _r4 = reg_write(p, CTRL_REG4, saved[3] as Int)
    let _r5 = reg_write(p, CTRL_REG5, saved[4] as Int)
    let _r1 = reg_write(p, CTRL_REG1, c1 & (0xFF ^ CTRL1_ST))
    let _r3 = reg_write(p, CTRL_REG3, saved[2] as Int)
    if not ok
        return None
    Some(MagNanoT { x: dx, y: dy, z: dz })

// Whether a self-test change `d` is within Table 3's limits, in
// nanotesla: 1 to 3 gauss on X and Y, 0.1 to 1 gauss on Z, in magnitude.
pub fn self_test_ok(d: MagNanoT) -> Bool
    abs_in(d.x, ST_XY_MIN, ST_XY_MAX) and abs_in(d.y, ST_XY_MIN, ST_XY_MAX) and abs_in(d.z, ST_Z_MIN, ST_Z_MAX)

// Whether the magnitude of `v` is within `lo` to `hi`.
fn abs_in(v: Int, lo: Int, hi: Int) -> Bool
    var a = v
    if a < 0
        a = 0 - a
    a >= lo and a <= hi

// ── Bring-up ─────────────────────────────────────────────────────────

// Brings the part up: the bus made ready; WHO_AM_I checked; the part put
// in power-down and its registers set to a known state, because it has no
// reset pin and keeps them across a restart of the program: ±4 gauss,
// ultra-high performance on X, Y and Z, block data update, 10 Hz, the
// temperature sensor off; then continuous conversion, and one read of the
// output registers so the DRDY pin starts low.  Answers whether the part
// answered as a LIS3MDL and took every setting.
pub fn start<P: Lis3mdlPort>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if reg_read(p, WHO_AM_I) != Some(ID_LIS3MDL)
        return false
    let ok = reg_write(p, CTRL_REG3, 0x03) and reg_write(p, CTRL_REG2, 0x00) and reg_write(p, CTRL_REG4, OM_ULTRA_HIGH << 2) and reg_write(p, CTRL_REG5, CTRL5_BDU) and reg_write(p, CTRL_REG1, (OM_ULTRA_HIGH << 5) | (DO_10_HZ << 2)) and reg_write(p, CTRL_REG3, 0x00)
    let _clear = sample_read(p)
    ok

// ── The part on an I2C bus ───────────────────────────────────────────

// A LIS3MDL on a board's I2C bus at the address `w.addr`, 0x1C or 0x1E,
// with the board's GPIO for the DRDY line.
pub @value
struct Lis3mdl
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Lis3mdlPort for Lis3mdl
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Lis3mdl
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Lis3mdl
        Lis3mdl { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The full scale.
    fn range(self) -> Lis3mdlRange [hw]
        range_read(self)

    // Sets the full scale.
    fn set_range(self, r: Lis3mdlRange) -> Bool [hw]
        range_write(self, r)

    // The performance mode.
    fn perf(self) -> Lis3mdlPerf [hw]
        perf_read(self)

    // Sets the performance mode of X, Y and Z.
    fn set_perf(self, m: Lis3mdlPerf) -> Bool [hw]
        perf_write(self, m)

    // The operating mode.
    fn power(self) -> Lis3mdlPower [hw]
        power_read(self)

    // Sets the operating mode.
    fn set_power(self, m: Lis3mdlPower) -> Bool [hw]
        power_write(self, m)

    // The rate in millihertz.
    fn rate_mhz(self) -> Int [hw]
        rate_read(self)

    // Sets the rate to the slowest at or above `mhz` millihertz and
    // answers the rate taken.
    fn set_rate_mhz(self, mhz: Int) -> Int [hw]
        rate_write(self, mhz)

    // The self-test change in nanotesla (`self_test_delta`).
    fn self_test(self) -> ?MagNanoT [hw]
        self_test_delta(self)

impl Magnetometer[hw] for Lis3mdl
    fn mag_read(self) -> ?MagNanoT [hw]
        sample_read(self)

    fn mag_ready(self) -> Bool [hw]
        sample_ready(self)

    // The rate in hertz, rounded up: 0.625 Hz is 1.
    fn mag_rate_hz(self) -> Int [hw]
        rate_hz_of(rate_read(self))

impl Identifiable[hw] for Lis3mdl
    // WHO_AM_I, 0x3D; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

// ── The part on an SPI bus ───────────────────────────────────────────

// A LIS3MDL on a board's SPI bus with the chip select `w.cs`, with the
// board's GPIO for the chip select and the DRDY line.
